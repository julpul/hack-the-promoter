# Skopiuj do .env i wpisz swoj klucz:  cp .env.example .env
# .env jest w .gitignore -- NIE commitujemy kluczy.

# Indywidualny klucz z hackathonu (naglowek X-API-Key)
HYPPE_API_KEY=

# Adres API (zwykle bez zmian)
HYPPE_URL=https://hyppe.futura.foundation

# Opcjonalne
# HYPPE_TIMEOUT=900          # timeout pojedynczego requestu w sekundach
# HYPPE_RETRIES=6            # liczba prob przy 429/503
# HYPPE_USER_AGENT=          # nadpisanie User-Agent (domyslnie przegladarkowy)
